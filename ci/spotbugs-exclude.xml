<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.1.0
                        https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

  <!-- Generated sources: not worth reporting on, nobody can fix them. -->
  <Match>
    <Source name="~.*[\\/]generated-sources[\\/].*"/>
  </Match>

  <!-- Test code: enable later if you want it analysed. -->
  <Match>
    <Class name="~.*\.*Test$"/>
  </Match>

  <!--
    Add real suppressions below as you triage findings, e.g.:

    <Match>
      <Class name="org.holodeckb2b.Foo"/>
      <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    Always add a comment explaining WHY. An unexplained suppression is
    indistinguishable from someone silencing a real bug.
  -->

</FindBugsFilter>
